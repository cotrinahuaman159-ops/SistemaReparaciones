@model SistemaReparaciones.Models.RegistrarReparacionViewModel

@{
    ViewData["Title"] = "Registrar reparación";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Registrar reparación</h1>

            <p class="text-muted">
                Solicitud #@Model.SolicitudServicioId
            </p>
        </div>

        <a asp-action="Detalle"
           asp-route-id="@Model.SolicitudServicioId"
           class="btn btn-secondary">
            Volver al servicio
        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-header bg-warning">

            <h5 class="mb-0">
                Información de la reparación
            </h5>

        </div>

        <div class="card-body">

            <form asp-action="RegistrarReparacion"
                  method="post">

                <input type="hidden"
                       asp-for="SolicitudServicioId" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- Trabajo realizado -->

                <div class="mb-4">

                    <label asp-for="TrabajoRealizado"
                           class="form-label">
                    </label>

                    <textarea asp-for="TrabajoRealizado"
                              class="form-control"
                              rows="5"
                              placeholder="Describa el trabajo realizado en el equipo">
                    </textarea>

                    <span asp-validation-for="TrabajoRealizado"
                          class="text-danger">
                    </span>

                </div>


                <!-- Repuestos -->

                <div class="mb-4">

                    <label asp-for="RepuestosUtilizados"
                           class="form-label">
                    </label>

                    <textarea asp-for="RepuestosUtilizados"
                              class="form-control"
                              rows="4"
                              placeholder="Indique los repuestos utilizados. Si no utilizó ninguno, puede indicarlo.">
                    </textarea>

                    <span asp-validation-for="RepuestosUtilizados"
                          class="text-danger">
                    </span>

                </div>
                <!-- Costo del servicio -->

                <div class="mb-4">

                    <label asp-for="CostoServicio"
                           class="form-label">
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            S/
                        </span>

                        <input asp-for="CostoServicio"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               placeholder="0.00" />

                    </div>

                    <span asp-validation-for="CostoServicio"
                          class="text-danger">
                    </span>

                </div>

                <!-- Observaciones -->

                <div class="mb-4">

                    <label asp-for="Observaciones"
                           class="form-label">
                    </label>

                    <textarea asp-for="Observaciones"
                              class="form-control"
                              rows="4"
                              placeholder="Ingrese observaciones adicionales">
                    </textarea>

                    <span asp-validation-for="Observaciones"
                          class="text-danger">
                    </span>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success">

                        Registrar reparación

                    </button>

                    <a asp-action="Detalle"
                       asp-route-id="@Model.SolicitudServicioId"
                       class="btn btn-secondary">

                        Cancelar

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

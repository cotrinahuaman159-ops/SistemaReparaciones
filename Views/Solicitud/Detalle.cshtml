@model SistemaReparaciones.Models.SolicitudAdminViewModel

@{
    ViewData["Title"] = "Detalle de solicitud";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Detalle de solicitud</h1>

            <p class="text-muted">
                Solicitud #@Model.Id
            </p>
        </div>

        <a asp-action="MisSolicitudes"
           class="btn btn-secondary">
            Volver a mis solicitudes
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <div class="row">

        <!-- Información del servicio -->
        <div class="col-md-6 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-header bg-primary text-white">

                    <h5 class="mb-0">
                        Información del servicio
                    </h5>

                </div>

                <div class="card-body">

                    <p>
                        <strong>Electrodoméstico:</strong><br />
                        @Model.Electrodomestico
                    </p>

                    <p>
                        <strong>Descripción de la falla:</strong><br />
                        @Model.DescripcionFalla
                    </p>

                    <p>
                        <strong>Dirección:</strong><br />
                        @Model.Direccion
                    </p>

                    <p>
                        <strong>Teléfono:</strong><br />
                        @Model.Telefono
                    </p>

                    <p>
                        <strong>Fecha solicitada:</strong><br />
                        @Model.FechaSolicitada.ToString("dd/MM/yyyy")
                    </p>

                    <p class="mb-0">
                        <strong>Fecha de registro:</strong><br />
                        @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                    </p>

                </div>

            </div>

        </div>


        <!-- Estado y técnico -->
        <div class="col-md-6 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-header bg-warning">

                    <h5 class="mb-0">
                        Estado del servicio
                    </h5>

                </div>

                <div class="card-body">

                    <p>
                        <strong>Estado:</strong><br />

                        @if (Model.Estado == "Pendiente")
                        {
                            <span class="badge bg-warning text-dark">
                                Pendiente
                            </span>
                        }
                        else if (Model.Estado == "Asignada")
                        {
                            <span class="badge bg-primary">
                                Asignada
                            </span>
                        }
                        else if (Model.Estado == "En reparación")
                        {
                            <span class="badge bg-info text-dark">
                                En reparación
                            </span>
                        }
                        else if (Model.Estado == "Finalizada")
                        {
                            <span class="badge bg-success">
                                Finalizada
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.Estado
                            </span>
                        }
                    </p>

                    <hr />

                    <p class="mb-0">
                        <strong>Técnico asignado:</strong><br />

                        @if (string.IsNullOrEmpty(Model.TecnicoId))
                        {
                            <span class="text-muted">
                                Aún no se ha asignado un técnico.
                            </span>
                        }
                        else
                        {
                            @Model.NombreTecnico
                        }
                    </p>

                </div>

            </div>

        </div>


        <!-- Diagnóstico -->
        <div class="col-md-12 mb-4">

            <div class="card shadow-sm">

                <div class="card-header bg-warning">

                    <h5 class="mb-0">
                        Diagnóstico técnico
                    </h5>

                </div>

                <div class="card-body">

                    @if (Model.DiagnosticoId == null)
                    {
                        <p class="text-muted mb-0">
                            El técnico aún no ha registrado el diagnóstico.
                        </p>
                    }
                    else
                    {
                        <p>
                            <strong>Diagnóstico:</strong><br />
                            @Model.DiagnosticoDescripcion
                        </p>

                        @if (!string.IsNullOrEmpty(Model.DiagnosticoObservaciones))
                        {
                            <p>
                                <strong>Observaciones:</strong><br />
                                @Model.DiagnosticoObservaciones
                            </p>
                        }

                        <small class="text-muted">
                            Registrado el
                            @Model.DiagnosticoFecha?.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    }

                </div>

            </div>

        </div>


        <!-- Reparación -->
        <div class="col-md-12 mb-4">

            <div class="card shadow-sm">

                <div class="card-header bg-success text-white">

                    <h5 class="mb-0">
                        Reparación realizada
                    </h5>

                </div>

                <div class="card-body">

                    @if (Model.ReparacionId == null)
                    {
                        <p class="text-muted mb-0">
                            Aún no se ha registrado la reparación.
                        </p>
                    }
                    else
                    {
                        <p>
                            <strong>Trabajo realizado:</strong><br />
                            @Model.ReparacionTrabajoRealizado
                        </p>
                        <div class="mb-3">

                            <strong>Costo del servicio:</strong>

                            <p class="mt-2">
                                S/ @Model.ReparacionCostoServicio?.ToString("N2")
                            </p>

                        </div>
                        @if (!string.IsNullOrEmpty(Model.ReparacionRepuestosUtilizados))
                        {
                            <p>
                                <strong>Repuestos utilizados:</strong><br />
                                @Model.ReparacionRepuestosUtilizados
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(Model.ReparacionObservaciones))
                        {
                            <p>
                                <strong>Observaciones:</strong><br />
                                @Model.ReparacionObservaciones
                            </p>
                        }

                        <small class="text-muted">
                            Registrada el
                            @Model.ReparacionFecha?.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
<!-- Calificación del servicio -->
<div class="col-md-12 mb-4">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">
                Calificación del servicio
            </h5>

        </div>

        <div class="card-body">

            @if (Model.CalificacionId == null)
            {
                @if (Model.Estado == "Finalizada")
                {
                    <p>
                        El servicio ha finalizado.
                        Puedes calificar la atención recibida.
                    </p>

                    <a asp-action="Calificar"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">

                        ⭐ Calificar servicio

                    </a>
                }
                else
                {
                    <p class="text-muted mb-0">
                        Podrás calificar el servicio cuando
                        la reparación haya finalizado.
                    </p>
                }
            }
            else
            {
                <div class="mb-3">

                    <strong>Puntuación:</strong>

                    <div class="mt-2">

                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Model.CalificacionPuntuacion)
                            {
                                <span class="fs-4 text-warning">★</span>
                            }
                            else
                            {
                                <span class="fs-4 text-secondary">☆</span>
                            }
                        }

                        <span class="ms-2">
                            (@Model.CalificacionPuntuacion / 5)
                        </span>

                    </div>

                </div>

                @if (!string.IsNullOrEmpty(Model.CalificacionComentario))
                {
                    <div class="mb-3">

                        <strong>Comentario:</strong>

                        <p class="mt-2">
                            @Model.CalificacionComentario
                        </p>

                    </div>
                }

                <hr />

                <small class="text-muted">

                    Calificado el
                    @Model.CalificacionFecha?.ToString("dd/MM/yyyy HH:mm")

                </small>

                <div class="mt-3">

                    <span class="badge bg-success">
                        Servicio calificado
                    </span>

                </div>
            }

        </div>

    </div>

</div>
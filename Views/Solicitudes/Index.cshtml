@model List<SistemaReparaciones.Models.SolicitudAdminViewModel>

@{
    ViewData["Title"] = "Gestión de solicitudes";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Gestión de solicitudes</h1>
            <p class="text-muted">
                Administración de las solicitudes de servicio.
            </p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No existen solicitudes registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <h3>Gestión de solicitudes</h3>
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-primary">
                    
                    <tr>
                        <th>ID</th>
                        <th>Cliente</th>
                        <th>Electrodoméstico</th>
                        <th>Detalle de Falla</th>
                        <th>Fecha solicitada</th>
                        <th>Estado</th>
                        <th>Técnico</th>
                        <th>Acciones</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var solicitud in Model)
                    {
                        <tr>

                            <td>
                                #@solicitud.Id
                            </td>

                            <td>
                                <strong>
                                    @solicitud.NombreCliente
                                </strong>
                                <br />

                                <small class="text-muted">
                                    @solicitud.Telefono
                                </small>
                            </td>

                            <td>
                                @solicitud.Electrodomestico
                            </td>

                            <td>
                                @solicitud.DescripcionFalla
                            </td>

                            <td>
                                @solicitud.FechaSolicitada.ToString("dd/MM/yyyy")
                            </td>

                            <td>

                                @if (solicitud.Estado == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pendiente
                                    </span>
                                }
                                else if (solicitud.Estado == "Asignada")
                                {
                                    <span class="badge bg-primary">
                                        Asignada
                                    </span>
                                }
                                else if (solicitud.Estado == "En proceso")
                                {
                                    <span class="badge bg-info text-dark">
                                        En proceso
                                    </span>
                                }
                                else if (solicitud.Estado == "Completada")
                                {
                                    <span class="badge bg-success">
                                        Completada
                                    </span>
                                }
                                else if (solicitud.Estado == "Cancelada")
                                {
                                    <span class="badge bg-danger">
                                        Cancelada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @solicitud.Estado
                                    </span>
                                }

                            </td>

                            <td>
                                @solicitud.NombreTecnico
                            </td>

                            <td>

                                <a asp-action="Detalle"
                                   asp-route-id="@solicitud.Id"
                                   class="btn btn-sm btn-primary">
                                    Ver
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
